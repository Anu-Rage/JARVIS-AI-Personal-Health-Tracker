# Supabase project settings (Project Settings -> API in the Supabase dashboard)
# JWTs are verified against the project's public JWKS endpoint (derived from
# SUPABASE_URL) rather than a shared secret -- no separate JWT secret needed.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=change-me

# Comma-separated list of origins allowed to call this API
CORS_ORIGINS=http://localhost:3000

# OpenAI (powers /api/v1/ai/chat -- gpt-4.1-mini)
OPENAI_API_KEY=change-me
